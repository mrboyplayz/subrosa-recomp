# Only the project itself is tracked; the game's files and build output stay local.
*

!.gitignore
!.gitattributes
!README.md
!scripts/
!scripts/**
!src/
!src/**
!tools/
!tools/**
!ida/
!ida/**

build/
dist/
tools/rust
__pycache__/
*.pyc
*.o
*.obj
*.exe
*.dll
*.a

# IDA project state contains copied binary data.
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.idb
*.crate
*.TAG
*.json
*.toml
*.rs