scale both divides by 100
    state[0] = (float)mouse_x * renderer_canvas_width / (float)sr_window_width;
    state[1] = (float)mouse_y * renderer_canvas_height / (float)sr_window_height;
----
    state[0] = (float)mouse_x * renderer_canvas_width / (float)(sr_window_width * 100);
    state[1] = (float)mouse_y * renderer_canvas_height / (float)(sr_window_height * 100);
