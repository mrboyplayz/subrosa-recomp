@@ right button ignored
    if (mouse_right_down)
        return;
    for (i = 0; i < key_event_count; i++) {
=>
    for (i = 0; i < key_event_count; i++) {
----
@@ released keys typed
        if (key->released)
            continue;
=>
        if (key->released == 1)
            continue;
----
@@ letters to z only
        if ((uint32_t)c - 'a' <= 'z' - 'a') {
=>
        if ((uint32_t)c - 'a' < 'z' - 'a') {
----
@@ letters kept small
                               (c - 'a' + 'A') | (key->modifiers & KMOD_CTRL ? PLAYER_COMPUTER_KEY_CTRL : 0));
=>
                               c | (key->modifiers & KMOD_CTRL ? PLAYER_COMPUTER_KEY_CTRL : 0));
----
@@ ctrl is shift
                               (c - 'a' + 'A') | (key->modifiers & KMOD_CTRL ? PLAYER_COMPUTER_KEY_CTRL : 0));
=>
                               (c - 'a' + 'A') | (key->modifiers & KMOD_SHIFT ? PLAYER_COMPUTER_KEY_CTRL : 0));
----
@@ letter not used
            key->used = 1;
        } else if ((uint32_t)c - '!' <= '_' - '!') {
=>
        } else if ((uint32_t)c - '!' <= '_' - '!') {
----
@@ symbols to backtick
        } else if ((uint32_t)c - '!' <= '_' - '!') {
=>
        } else if ((uint32_t)c - '!' <= '`' - '!') {
----
@@ shift ignored
            queue_computer_key(player, computer, key->modifiers & KMOD_SHIFT ? shifted_characters[c & 0x7F] : c);
=>
            queue_computer_key(player, computer, c);
----
@@ shift is left shift only
            queue_computer_key(player, computer, key->modifiers & KMOD_SHIFT ? shifted_characters[c & 0x7F] : c);
=>
            queue_computer_key(player, computer, key->modifiers & 1 ? shifted_characters[c & 0x7F] : c);
----
@@ space not typed
            queue_computer_key(player, computer, ' ');
=>
            (void)0;
----
@@ enter as carriage return
            queue_computer_key(player, computer, PLAYER_COMPUTER_KEY_ENTER);
=>
            queue_computer_key(player, computer, '\r');
----
@@ backspace not used
