startup fatal error returns a nonzero pointer
    startup_message_box(16, "Fatal Error", "Out of memory - aborting", 0);
    return 0;
----
    startup_message_box(16, "Fatal Error", "Out of memory - aborting", 0);
    return (void *)1;
====
startup fatal error drops the message box flags
startup_message_box(16, "Fatal Error", "Out of memory - aborting", 0);
----
startup_message_box(0, "Fatal Error", "Out of memory - aborting", 0);
====
startup fatal error swaps the title and text
startup_message_box(16, "Fatal Error", "Out of memory - aborting", 0);
----
startup_message_box(16, "Out of memory - aborting", "Fatal Error", 0);
====
startup fatal error changes the text
startup_message_box(16, "Fatal Error", "Out of memory - aborting", 0);
----
startup_message_box(16, "Fatal Error", "Out of memory", 0);
====
startup fatal error uses a nonzero window
startup_message_box(16, "Fatal Error", "Out of memory - aborting", 0);
----
startup_message_box(16, "Fatal Error", "Out of memory - aborting", 16);
