skip the first mesh build counter
for (size_t i = 0; i < (size_t)((uint32_t *)MESH_BUILD_END - (uint32_t *)MESH_BUILD_BASE); ++i)
        counter[i] = (uint32_t)nc_rand();
----
for (size_t i = 1; i < (size_t)((uint32_t *)MESH_BUILD_END - (uint32_t *)MESH_BUILD_BASE); ++i)
        counter[i] = (uint32_t)nc_rand();
====
skip the last record word
for (size_t i = 0; i < RECORD_WORDS; ++i)
        records[i] = (uint32_t)nc_rand();
----
for (size_t i = 0; i < RECORD_WORDS - 1; ++i)
        records[i] = (uint32_t)nc_rand();
====
force the a2==1 builder off
int a2 = (int)(nc_rand() % 4) - 1; /* 0 and 1 in most cases */
----
int a2 = 2; /* never 1 */
